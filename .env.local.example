# Cópia para .env.local e preencha com as credenciais do Supabase LOCAL.
# O Vite carrega .env.local e ele tem prioridade sobre .env (conexão local).
#
# 1. Suba o Supabase local:  npx supabase start
# 2. Veja a URL e a chave:   npx supabase status
# 3. Copie API URL e anon key abaixo.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<cole aqui o "anon key" do output do supabase status>

# Opcional (só se o app usar):
# VITE_SUPABASE_PROJECT_ID=local
