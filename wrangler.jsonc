{
  // Deploy do FitRank como site estático (Workers static assets).
  // SPA: rotas do react-router caem no index.html.
  "name": "fitrank",
  "compatibility_date": "2026-08-01",
  "routes": [{ "pattern": "fitrank.oxehub.com.br", "custom_domain": true }],
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Só /api/* chega no Worker; o resto sai direto do CDN de assets.
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "fitrank" }],
  // SUPABASE_URL/ANON_KEY são usadas pelo worker/index.ts para validar o
  // token do usuário antes do upload do avatar no R2. Apontam para o
  // Supabase self-hosted no VPS (docs/operacao-producao.md).
  "vars": {
    "SUPABASE_URL": "https://api-fitrank.oxehub.com.br",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzg4MjI5NTY4LCJleHAiOjIxMDM1ODk1Njh9.wbr0O_4BugwBjZWyZsVy5JDa0wcOKbpsRAxN-YvWbG0",
    // 1 nível só: o certificado universal (*.oxehub.com.br) não cobre sub-subdomínio.
    "MEDIA_BASE_URL": "https://cdn-fitrank.oxehub.com.br"
  }
}
