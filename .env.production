# Produção: backend Supabase self-hosted no VPS (ver docs/operacao-producao.md).
#
# Versionado de propósito, e não é segredo: a anon key é pública por desenho —
# ela já ia no bundle do front, e quem chega com ela só alcança o que a RLS
# permitir. Antes isto vivia só no .env de cada máquina, o que tornava o build
# de produção dependente de um arquivo não versionado; pior, com um .env.local
# apontando para o Supabase local, o build saía apontando para 127.0.0.1.
#
# No Vite, .env.production tem prioridade sobre .env.local em `vite build`,
# então o build de produção agora é reprodutível em qualquer máquina.
VITE_SUPABASE_URL=https://api-fitrank.oxehub.com.br
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzg4MjI5NTY4LCJleHAiOjIxMDM1ODk1Njh9.wbr0O_4BugwBjZWyZsVy5JDa0wcOKbpsRAxN-YvWbG0
VITE_SUPABASE_PROJECT_ID=fitrank-vps
