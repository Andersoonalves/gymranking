# Roteia a API do Supabase self-hosted. TLS e o domínio ficam no proxy central
# (~/proxy no VPS), que entrega aqui em HTTP pela rede `web` — por isso `:80`
# e não o nome do host.
#
# Os prefixos e reescritas são os mesmos do gateway oficial (Envoy, em
# volumes/api/envoy/lds.template.yaml): cada serviço recebe o path já sem o
# `/<serviço>/v1`, que é como eles montam as próprias rotas.
:80 {
	log {
		output stdout
		format console
	}

	# ---- CORS ----
	# O front mora em fitrank.oxehub.com.br e a API aqui: toda chamada do app é
	# cross-origin. O gateway oficial resolve isso com um filtro CORS no virtual
	# host inteiro; sem ele, medindo cada serviço: o PostgREST e as Edge
	# Functions respondem por conta, mas o **GoTrue devolve 204 sem
	# Access-Control-Allow-Origin** e o storage devolve 404 no preflight — ou
	# seja, o login quebraria no navegador. Então o CORS é feito aqui, para
	# todas as rotas, como no Envoy.
	#
	# `header` no Caddy é set, não append: onde o upstream já manda o header, o
	# valor é substituído em vez de duplicado (header duplicado o navegador
	# recusa). `defer` faz isso rodar depois da resposta do upstream.
	header {
		defer
		Access-Control-Allow-Origin "*"
		Access-Control-Expose-Headers "*"
	}

	# Preflight não precisa chegar ao upstream — e não pode, já que metade
	# deles responde errado. Mesmos valores do filtro do Envoy.
	@preflight method OPTIONS
	handle @preflight {
		header {
			Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD"
			Access-Control-Allow-Headers "*"
			Access-Control-Max-Age "3600"
		}
		respond 204
	}

	# `handle_path` já remove o prefixo — equivale ao prefix_rewrite: / do Envoy.
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}

	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}

	handle_path /storage/v1/* {
		# Mesmo header que o gateway oficial injeta nesta rota, já que o
		# prefixo é removido acima. O /object/sign não depende dele (medido),
		# mas os endpoints que montam URL absoluta, sim.
		reverse_proxy storage:5000 {
			header_up X-Forwarded-Prefix /storage/v1
		}
	}

	# O main-service do edge-runtime lê o nome da função do primeiro segmento
	# do path, então ele precisa chegar como /<funcao>.
	handle_path /functions/v1/* {
		reverse_proxy functions:9000
	}

	# Qualquer outra coisa não é rota da API: responde 404 em vez de vazar
	# um erro de proxy.
	handle {
		respond "not found" 404
	}
}
