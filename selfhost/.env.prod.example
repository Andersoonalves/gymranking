# Modelo do .env do Supabase self-hosted. No servidor ele vive em
# ~/fitrank/selfhost/.env com chmod 600 e nunca entra no git.
#
# Gerar de uma vez as três primeiras:
#   node selfhost/gerar-chaves.mjs
#
# JWT_SECRET assina ANON_KEY e SERVICE_ROLE_KEY: trocar um exige trocar os três
# juntos, e derruba toda sessão aberta no app.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# openssl rand -hex 24
POSTGRES_PASSWORD=

# Onde a API responde. Entra no `iss` dos tokens do GoTrue e na base das URLs
# assinadas do storage — mudar depois invalida token emitido.
# Um nível só de subdomínio: o certificado universal do Cloudflare não cobre
# sub-subdomínio (mesma pegadinha já anotada no wrangler.jsonc).
SUPABASE_PUBLIC_URL=https://api-fitrank.oxehub.com.br

# O front mora noutro domínio que a API. É para cá que volta o link do e-mail.
SITE_URL=https://fitrank.oxehub.com.br
ADDITIONAL_REDIRECT_URLS=http://localhost:8080

# Segundos de validade do access token. 3600 é o padrão do Supabase Cloud.
JWT_EXPIRY=3600
DISABLE_SIGNUP=false

# SMTP do GoTrue (confirmação de cadastro e recuperação de senha). Sem isto o
# cadastro só funciona com ENABLE_EMAIL_AUTOCONFIRM=true, que dispensa a
# confirmação por e-mail — aceitável para validar, não para produção.
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=FitRank

# Web push das Edge Functions (JWK gerado por scripts/generate-vapid-jwk.ts).
# Tem que ser O MESMO do Supabase Cloud: a chave pública fica guardada em cada
# subscription já registrada no navegador do usuário, então par novo cala o
# push de todo mundo que já ativou notificação.
# Copiar de: Supabase Cloud > Project Settings > Edge Functions > Secrets.
VAPID_KEYS_JWK=
